<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Registro">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:background="#F8F6FC">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Encabezado -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registrar mascota"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#6750A4" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Completa los datos de tu mascota."
                android:textSize="14sp"
                android:textColor="#666666" />

            <!-- Nombre -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Nombre de la mascota"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etNombreMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Ej. Max"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <!-- Especie -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Especie"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spEspecie"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="6dp" />

            <!-- Raza -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Raza"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="Ingresar raza"
                android:inputType="textCapWords"
                android:singleLine="true" />

            <!-- Fecha -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Fecha de nacimiento"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFechaNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Seleccionar fecha" />

            <!-- Estado del registro -->
            <TextView
                android:id="@+id/txtEstadoRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text=""
                android:textSize="14sp"
                android:textColor="#6750A4" />

            <!-- Guardar -->
            <Button
                android:id="@+id/btnGuardarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Guardar mascota" />

            <!-- Cancelar -->
            <Button
                android:id="@+id/btnCancelarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Cancelar" />


            <!-- SECCIÓN: VACUNAS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Registro de vacunas"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#6750A4" />

            <EditText
                android:id="@+id/etNombreVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Nombre de la vacuna"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etLoteVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Número de lote"
                android:inputType="text" />

            <Button
                android:id="@+id/btnFechaVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Fecha de aplicación" />

            <Button
                android:id="@+id/btnGuardarVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardar vacuna"
                android:enabled="false" />


            <!-- SECCIÓN: DIETA -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Alimentación y dieta"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#6750A4" />

            <EditText
                android:id="@+id/etMarcaAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Marca o tipo de alimento"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etRacionGramos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Ración en gramos"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/etFrecuenciaDiaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Comidas por día"
                android:inputType="number" />

            <Button
                android:id="@+id/btnGuardarDieta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardar dieta"
                android:enabled="false" />


            <!-- SECCIÓN: VISITAS VETERINARIAS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Visitas veterinarias"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#6750A4" />

            <Button
                android:id="@+id/btnFechaVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Fecha de visita" />

            <EditText
                android:id="@+id/etLugarVeterinaria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Clínica o veterinaria"
                android:inputType="textCapWords" />

            <EditText
                android:id="@+id/etMotivoVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Motivo de la consulta"
                android:inputType="textCapSentences" />

            <EditText
                android:id="@+id/etDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Diagnóstico u observaciones"
                android:inputType="textMultiLine"
                android:minLines="2" />

            <Button
                android:id="@+id/btnGuardarVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Guardar visita veterinaria"
                android:enabled="false" />

            
        </LinearLayout>


    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>