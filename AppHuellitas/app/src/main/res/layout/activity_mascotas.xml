<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MascotasPantalla">

    <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Registro de mascotas y cuidados"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEstadoMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Primero guarda una mascota para asociar sus datos."
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Mascota"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etIdUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="ID del usuario"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de la mascota"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etEspecie"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Especie"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etRaza"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Raza"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etNacimiento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha de nacimiento (AAAA-MM-DD)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etFotoUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="URL de foto (opcional)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGuardarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Guardar mascota" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Vacuna"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etNombreVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Nombre de la vacuna"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etLote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Lote"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etFechaVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha de aplicación (AAAA-MM-DD)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGuardarVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar vacuna" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Registro físico"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etFechaRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha (AAAA-MM-DD)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etPeso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Peso (kg)"
                android:inputType="numberDecimal"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etAltura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Altura (cm)"
                android:inputType="numberDecimal"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGuardarRegistro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar registro físico" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Dieta"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etMarcaAlimento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Marca del alimento"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etRacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Ración en gramos"
                android:inputType="number"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etFrecuencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Veces al día"
                android:inputType="number"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGuardarDieta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar dieta" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Visita veterinaria"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etFechaVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha (AAAA-MM-DD)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etLugar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Lugar"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etMotivo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Motivo"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etDiagnostico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Diagnóstico"
                android:inputType="text"
                android:importantForAutofill="no" />

            <Button
                android:id="@+id/btnGuardarVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar visita" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Recordatorio"
                android:textStyle="bold"
                android:textSize="19sp" />

            <EditText
                android:id="@+id/etTituloRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Título"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etFechaHora"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Fecha y hora (AAAA-MM-DD HH:MM)"
                android:inputType="text"
                android:importantForAutofill="no" />

            <EditText
                android:id="@+id/etTipoNotificacion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tipo de notificación"
                android:inputType="text"
                android:importantForAutofill="no" />

            <CheckBox
                android:id="@+id/checkActivo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recordatorio activo"
                android:checked="true" />

            <Button
                android:id="@+id/btnGuardarRecordatorio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Agregar recordatorio" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>