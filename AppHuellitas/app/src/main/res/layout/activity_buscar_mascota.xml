<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BuscarMascota">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF7FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar mascota"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBuscarId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="29c4bdf3-e60c-414a-9371-771225e7918e"
                android:inputType="text" />

            <Button
                android:id="@+id/btnBuscarId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar mascota"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Los datos aparecerán aquí"
                android:textSize="16sp"
                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Vacunas registradas"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spVacunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtDetalleVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Busca una mascota para consultar sus vacunas."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEliminarVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar vacuna"
                android:enabled="false"
                android:visibility="gone" />


            <Button
                android:id="@+id/btnEditarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Actualizar mascota"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEliminarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Eliminar mascota"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>