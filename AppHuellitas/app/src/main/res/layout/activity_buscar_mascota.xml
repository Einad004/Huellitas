<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".BuscarMascota">

    <ScrollView
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FAF7FF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar mascota"
                android:textSize="24sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etBuscarId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="21db873a-6ab0-426e-829b-b07578b2b5b4"
                android:inputType="text" />

            <Button
                android:id="@+id/btnBuscarId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Buscar mascota"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/txtResultado"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Los datos aparecerán aquí"
                android:textSize="16sp"
                />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Vacunas registradas"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Spinner
                android:id="@+id/spVacunas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtDetalleVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Busca una mascota para consultar sus vacunas."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEliminarVacuna"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar vacuna"
                android:enabled="false"
                android:visibility="visible"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Alimentación registrada"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorDietas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Visitas veterinarias"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/contenedorVisitas"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/txtDetalleVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Busca una mascota para consultar sus visitas."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEliminarVisita"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar visita veterinaria"
                android:enabled="false"
                android:visibility="visible" />

            <TextView
                android:id="@+id/txtDetalleDieta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Busca una mascota para consultar su alimentación."
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnEliminarDieta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Eliminar alimentación"
                android:enabled="false"
                android:visibility="visible" />

            <Button
                android:id="@+id/btnEditarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Actualizar mascota y cuidados"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnEliminarMascota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Eliminar mascota"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>